# ───────────────────────────────────────────────────
#  DEVURITYWEB — Plantilla de Configuración (.env)
# ───────────────────────────────────────────────────
#  Copia este archivo como `.env` en la raíz del
#  proyecto y define las variables locales necesarias.
#  Este archivo NO se sube a Git (.gitignore lo excluye).
# ───────────────────────────────────────────────────

# ── SECTION: APP ───────────────────────────────────
# URLs base para CORS, confirmación de correos,
# sitemaps y robots.txt.
# Default para desarrollo: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ── SECTION: AUTH ──────────────────────────────────
# Clave secreta para firmar tokens JWT y códigos QR.
# Generar clave segura en terminal con:
#   openssl rand -hex 64
# [REQUIRED]
JWT_SECRET=""


# ── SECTION: DATABASE ──────────────────────────────
# URL de conexión de base de datos PostgreSQL local.
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# [REQUIRED]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devurity?schema=public"


# ── SECTION: EMAIL ─────────────────────────────────
# https://myaccount.google.com/apppasswords
# Remitente de correos institucionales y tokens.
# EMAIL_PORT: 587 (TLS/Gmail)
# [REQUIRED]
EMAIL="tu-correo@gmail.com"
KEY_EMAIL=""
EMAIL_PORT=587


# ── SECTION: STORAGE ───────────────────────────────
# Credenciales de Supabase Storage para la galería de imágenes.
# NEXT_PUBLIC_SUPABASE_URL / ANON_KEY: público, seguros de exponer al cliente.
# SUPABASE_SERVICE_ROLE_KEY: Solo servidor (secreto, nunca exponer al cliente).
# [REQUIRED para la galería]
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Nombre del bucket de Storage usado para la galería (se crea automáticamente si no existe).
SUPABASE_GALLERY_BUCKET="gallery"


# ── SECTION: CACHE ─────────────────────────────────
# Cache buster de actualizaciones. Incrementar para
# forzar a los clientes a recargar el feed.
NEXT_PUBLIC_UPDATES_CACHE_REV="stable"
